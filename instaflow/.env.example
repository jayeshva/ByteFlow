# InstaFlow Frontend Environment Variables

# The Base URL of your deployed Cloud Run API
VITE_API_BASE_URL=https://instaflow-api-164769631212.us-central1.run.app

# Meta / Instagram App Credentials
VITE_META_CLIENT_ID=your_instagram_app_id
VITE_META_REDIRECT_URI=https://instaflow.jaydesk.com/auth-callback

# Optional: API Timeout
VITE_API_TIMEOUT_MS=15000
