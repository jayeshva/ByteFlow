# --- Mode Configuration ---
# Options: local (API + Worker combined), worker (Worker only), api (API only)
RUN_MODE=local
NODE_ENV=development
PORT=4000

# --- Database ---
DATABASE_URL="postgresql://instaflow:instaflow_dev@localhost:5432/instaflow?schema=public"

JWT_SECRET="your-32-character-minimum-secret-here"
JWT_REFRESH_SECRET="your-other-secret-here"

# --- Google OAuth ---
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# --- SMTP (Zoho Mail) ---
SMTP_HOST="smtppro.zoho.in"
SMTP_PORT=465
SMTP_USER="no-reply@instaflow.me"
SMTP_PASS="your_app_password"
SMTP_FROM="noreply@instaflow.me"

# --- Instagram Webhooks (API Mode) ---
IG_WEBHOOK_VERIFY_TOKEN="your_token_here"
IG_CLIENT_ID="your_ig_id"
IG_CLIENT_SECRET="your_ig_secret"
IG_REDIRECT_URI="http://localhost:4000/auth/instagram/callback"

# --- BullMQ / Redis (Local Mode) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- GCP Pub/Sub (Cloud Mode) ---
GCP_PROJECT_ID="your-project-id"
PUBSUB_TOPIC="instagram-webhooks"
PUBSUB_SUBSCRIPTION="instagram-webhooks-sub"

# --- Payment Providers ---
DODO_API_KEY="test_..."
CASHFREE_APP_ID="..."
CASHFREE_SECRET_KEY="..."
CASHFREE_ENVIRONMENT=TEST

# --- App Settings ---
FRONTEND_URL="http://localhost:3000"
